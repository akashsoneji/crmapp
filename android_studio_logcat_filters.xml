<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Studio Logcat Filter Configuration
  This file can be imported into Android Studio to automatically filter out
  WebView and GPU system logs that clutter the console.
  
  How to import:
  1. Open Android Studio
  2. Go to View > Tool Windows > Logcat
  3. Click the filter dropdown (funnel icon)
  4. Click "Edit Filter Configuration"
  5. Click the "+" button to add a new filter
  6. Name it "Hide WebView Noise"
  7. In the "Log Tag" field, use regex: ^(?!.*(View|ImageReader_JNI|GPUAUX)).*$
  8. Or manually configure as shown below
-->
<logcatFilters>
    <!-- Filter to hide WebView frame rate logs -->
    <filter name="Hide WebView Noise" enabled="true">
        <tag>^(?!.*View).*$</tag>
        <message>^(?!.*(setRequestedFrameRate|frameRate=-4\.0)).*$</message>
        <level>VERBOSE</level>
    </filter>
    
    <!-- Filter to hide ImageReader warnings -->
    <filter name="Hide ImageReader Warnings" enabled="true">
        <tag>^(?!.*ImageReader_JNI).*$</tag>
        <message>^(?!.*(Unable to acquire a buffer item)).*$</message>
        <level>VERBOSE</level>
    </filter>
    
    <!-- Filter to hide GPU auxiliary errors -->
    <filter name="Hide GPU Errors" enabled="true">
        <tag>^(?!.*GPUAUX).*$</tag>
        <message>^(?!.*(GuiExtAuxCheckAuxPath|Null anb)).*$</message>
        <level>VERBOSE</level>
    </filter>
    
    <!-- Combined filter (recommended) -->
    <filter name="Hide All WebView/GPU Noise" enabled="true">
        <tag>^(?!.*(View|ImageReader_JNI|GPUAUX)).*$</tag>
        <message>^(?!.*(setRequestedFrameRate|frameRate=-4\.0|Unable to acquire a buffer item|GuiExtAuxCheckAuxPath|Null anb)).*$</message>
        <level>VERBOSE</level>
    </filter>
</logcatFilters>

<!--
  Manual Configuration Instructions for Android Studio:
  
  Option 1: Using Log Tag Filter (Recommended)
  -----------------------------------------------
  1. Open Logcat in Android Studio
  2. Click the filter dropdown (funnel icon)
  3. Click "Edit Filter Configuration"
  4. Add new filter named "Hide WebView Noise"
  5. Set Log Tag regex to: ^(?!.*(View|ImageReader_JNI|GPUAUX)).*$
  6. Click OK and select this filter from the dropdown
  
  Option 2: Using Log Message Filter
  ----------------------------------
  1. Follow steps 1-4 above
  2. Set Log Message regex to: ^(?!.*(setRequestedFrameRate|frameRate=-4\.0|Unable to acquire a buffer item|GuiExtAuxCheckAuxPath|Null anb)).*$
  3. Click OK and select this filter
  
  Option 3: Quick Filter (Temporary)
  -----------------------------------
  In the Logcat search box, type:
  !setRequestedFrameRate !ImageReader_JNI !GPUAUX
  
  This will hide logs containing these patterns (works temporarily)
-->

