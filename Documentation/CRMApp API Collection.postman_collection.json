{
  "info": {
    "name": "CRM App API - Module Wise",
    "description": "Import-ready Postman collection generated from the current Flutter app API constants, services, controllers, IBM provider, and PMAM service. Every request includes its HTTP method, endpoint path, path variables, query parameters, and sample JSON or multipart form-data body wherever the app sends them. Set base_url and auth_token before use. Authenticated requests use Bearer {{auth_token}}. URLs containing ?key=value are imported by Postman as editable query parameters; {{variable}} segments are editable path parameters; raw/form-data bodies contain request body parameters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://your-domain.com" },
    { "key": "auth_token", "value": "paste-auth-token-here" },
    { "key": "user_id", "value": "1" },
    { "key": "account_number", "value": "1000001" },
    { "key": "account_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "position_id", "value": "1" },
    { "key": "plan_id", "value": "1" },
    { "key": "subscription_id", "value": "1" },
    { "key": "ticket_id", "value": "1" },
    { "key": "client_id", "value": "1" },
    { "key": "ib_id", "value": "1" },
    { "key": "master_code", "value": "MASTER001" },
    { "key": "copier_id", "value": "1" },
    { "key": "node_id", "value": "1" },
    { "key": "payout_id", "value": "1" },
    { "key": "material_id", "value": "1" },
    { "key": "scratch_card_id", "value": "1" },
    { "key": "currency", "value": "USD" },
    { "key": "page", "value": "1" },
    { "key": "per_page", "value": "20" },
    { "key": "limit", "value": "20" },
    { "key": "period", "value": "mtd" },
    { "key": "scope", "value": "direct" },
    { "key": "range", "value": "30d" },
    { "key": "timeframe", "value": "30d" },
    { "key": "status", "value": "all" },
    { "key": "search", "value": "" },
    { "key": "q", "value": "" },
    { "key": "otp", "value": "123456" },
    { "key": "withdrawal_method_id", "value": "1" },
    { "key": "department_id", "value": "1" },
    { "key": "country_id", "value": "1" },
    { "key": "state_id", "value": "1" },
    { "key": "investor_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{auth_token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "01 - Authentication & Account",
      "item": [
        { "name": "Login", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/login" } },
        { "name": "Register", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"mobile\": \"+1234567890\",\n  \"otp_verification_type\": \"email\",\n  \"register_event_type\": \"register\",\n  \"accept_terms\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/register" } },
        { "name": "Send OTP", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp_verification_type\": \"email\",\n  \"register_event_type\": \"register\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/send-otp" } },
        { "name": "Verify OTP", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"otp_verification_type\": \"email\",\n  \"register_event_type\": \"verifyOtp\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/verify-otp" } },
        { "name": "Forgot Password Email", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/password/email" } },
        { "name": "Request Password Reset OTP", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/password/forgot" } },
        { "name": "Verify Password Reset OTP", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/password/verify-otp" } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewPassword123\",\n  \"password_confirmation\": \"NewPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/password/reset" } },
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{base_url}}/api/user/settings/profile" } },
        { "name": "Update Profile", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"mobile\": \"+1234567890\",\n  \"country_id\": 1,\n  \"state_id\": 1,\n  \"city_id\": 1,\n  \"address\": \"123 Main Street\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/profile" } },
        { "name": "Change User Password", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"OldPassword123\",\n  \"password\": \"NewPassword123\",\n  \"password_confirmation\": \"NewPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/change-password" } },
        { "name": "Delete Account", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"password\": \"password123\",\n  \"reason\": \"No longer need the service\",\n  \"accept_terms\": true,\n  \"confirm_deletion\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/delete-account" } },
        { "name": "Register FCM Token", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"fcm_token\": \"device-fcm-token\",\n  \"device_type\": \"android\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/register-fcm-token" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/api/user/logout" } },
        { "name": "Google OTP Generate", "request": { "method": "POST", "url": "{{base_url}}/api/user/settings/google-otp/generate" } },
        { "name": "Google OTP Verify", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/google-otp/verify" } },
        { "name": "Google OTP Disable", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/google-otp/disable" } }
      ]
    },
    {
      "name": "02 - App, Dashboard & Instruments",
      "item": [
        { "name": "Mobile App Details - Public", "request": { "method": "GET", "url": "{{base_url}}/api/user/mobile-app-details" } },
        { "name": "CRM Settings - Public", "request": { "method": "GET", "url": "{{base_url}}/api/user/crm-settings" } },
        { "name": "Enabled Modules", "request": { "method": "GET", "url": "{{base_url}}/api/user/enabled-modules" } },
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{base_url}}/api/user/dashboard" } },
        { "name": "Notifications", "request": { "method": "GET", "url": "{{base_url}}/api/user/notifications" } },
        { "name": "Get Instruments", "request": { "method": "GET", "url": "{{base_url}}/api/user/instruments" } },
        { "name": "Get Instruments By Account", "request": { "method": "GET", "url": "{{base_url}}/api/user/instruments/{{account_number}}" } },
        { "name": "Get Countries", "request": { "method": "GET", "url": "{{base_url}}/api/user/settings/getCountryDropdown" } },
        { "name": "Get States", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"country_id\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/getStateDropdown" } },
        { "name": "Get Cities", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"state_id\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/settings/getCityDropdown" } }
      ]
    },
    {
      "name": "03 - MT5 Accounts",
      "item": [
        { "name": "List MT5 Accounts", "request": { "method": "GET", "url": "{{base_url}}/api/user/mt5accounts/get" } },
        { "name": "Create MT5 Account", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"plan_id\": {{plan_id}},\n  \"account_type\": \"demo\",\n  \"leverage\": 100\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/mt5accounts/create" } },
        { "name": "Set Demo Account Balance", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\",\n  \"amount\": 10000\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/mt5accounts/setbalance" } },
        { "name": "Sync MT5 Accounts", "request": { "method": "POST", "url": "{{base_url}}/api/user/mt5accounts/mt5AccountSync" } },
        { "name": "Plan Details", "request": { "method": "GET", "url": "{{base_url}}/api/user/mt5accounts/plandetails" } },
        { "name": "Change Primary Account", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/mt5accounts/changePrimaryAccount" } },
        { "name": "Change MT5 Password", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\",\n  \"password\": \"NewPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/mt5accounts/changepassword" } },
        { "name": "Change MT5 Leverage", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\",\n  \"leverage\": 100\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/mt5accounts/changeleverage" } }
      ]
    },
    {
      "name": "04 - Trading & Price Alerts",
      "item": [
        { "name": "Trade History", "request": { "method": "GET", "url": "{{base_url}}/api/user/trade/tradehistory?page=1&per_page=20" } },
        { "name": "Place New Order", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\",\n  \"symbol\": \"EURUSD\",\n  \"volume\": 0.01,\n  \"type\": \"buy\",\n  \"price\": 1.085,\n  \"stop_loss\": 0,\n  \"take_profit\": 0\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/new-order" } },
        { "name": "Close Position By Position ID", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"position_id\": \"{{position_id}}\",\n  \"mt5_account\": \"{{account_number}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/closePositionByPositionId" } },
        { "name": "Close Pending Order", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"mt5_account\": \"{{account_number}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/closePendingOrder" } },
        { "name": "Cancel Pending Order", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"mt5_account\": \"{{account_number}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/cancel-pending-order" } },
        { "name": "Modify Pending Order", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"price\": 1.085,\n  \"stop_loss\": 0,\n  \"take_profit\": 0\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/modify-pending-order" } },
        { "name": "Close All Positions", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"mt5_account\": \"{{account_number}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/closePositions" } },
        { "name": "Update TP SL", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"position_id\": \"{{position_id}}\",\n  \"stop_loss\": 1.08,\n  \"take_profit\": 1.09\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/trade/update-tp-sl" } },
        { "name": "List Price Alerts", "request": { "method": "GET", "url": "{{base_url}}/api/user/price-alerts" } },
        { "name": "Create Price Alert", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"symbol\": \"EURUSD\",\n  \"condition\": \"above\",\n  \"price\": 1.09\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/price-alerts" } }
      ]
    },
    {
