        { "name": "Currency List", "request": { "method": "GET", "url": "{{base_url}}/api/user/utility/currency-list" } },
        { "name": "Check Withdrawal Balance", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"amount\": 100,\n  \"currency\": \"USD\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/withdrawal/checkbalance" } },
        { "name": "Withdrawal Methods", "request": { "method": "GET", "url": "{{base_url}}/api/user/withdrawal/withdrawal-method/{{currency}}" } },
        { "name": "User Withdrawal Methods", "request": { "method": "GET", "url": "{{base_url}}/api/user/withdrawal/getUserWithdrawalMethods" } },
        { "name": "Send Withdrawal OTP", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"amount\": 100,\n  \"withdrawal_method_id\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/withdrawal/sendOTP" } },
        { "name": "Submit Withdrawal Request", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"withdrawal_method\": \"bank\",\n  \"currency\": \"USD\",\n  \"amount\": 100,\n  \"otp\": \"{{otp}}\",\n  \"relationship\": \"self\",\n  \"bank_holder_name\": \"John Doe\",\n  \"bank_name\": \"Example Bank\",\n  \"bank_account_no\": \"0000000000\",\n  \"confirm_bank_account_no\": \"0000000000\",\n  \"ifsc_iban\": \"EXAMPLE0001\",\n  \"account_type\": \"bank\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/withdrawal/withdrawalrequest" } },
        { "name": "Internal Transfer Request", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"from_account\": \"{{account_number}}\",\n  \"to_account\": \"1000002\",\n  \"amount\": 100,\n  \"otp\": \"{{otp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/api/user/internaltransfer/request" } },
        { "name": "Internal Transfer History", "request": { "method": "GET", "url": "{{base_url}}/api/user/internaltransfer/history?page=1&per_page=20" } }
